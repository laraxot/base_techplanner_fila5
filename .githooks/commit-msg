#!/usr/bin/env bash
# Commit degli agenti AI: ognuno cita la sua GitHub issue (#123, Refs #123, Closes #123, owner/repo#123). Regola di AGENTS.md.
# Facoltativo, solo nel clone di un agente: git config core.hooksPath .githooks (non vale per i commit di Marco).
msg_file="$1"
first_line=$(head -n 1 "$msg_file")
case "$first_line" in
    Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac
if grep -v '^#' "$msg_file" | grep -Eq '(^|[^[:alnum:]_&])([[:alnum:]_.-]+/[[:alnum:]_.-]+)?#[0-9]+'; then
    exit 0
fi
echo "Commit rifiutato: il messaggio deve citare la GitHub issue (es. 'Refs #61' o 'Closes #61')." >&2
echo "Se l'issue non esiste ancora, aprila prima di committare." >&2
exit 1
