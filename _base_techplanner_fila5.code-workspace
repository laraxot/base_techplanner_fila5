{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"editor.formatOnSave": true,
		"editor.parameterHints.enabled": false,
		"editor.defaultFormatter": "junstyle.php-cs-fixer",
		"editor.wordWrap": "wordWrapColumn",
		"editor.wordWrapColumn": 120,
		"editor.tabSize": 4,
		"editor.insertSpaces": true,
		"files.eol": "\n",
		"files.trimTrailingWhitespace": true,
		"files.insertFinalNewline": true,
		"files.encoding": "utf8",
		"[php]": {
			"editor.defaultFormatter": "junstyle.php-cs-fixer",
			"editor.tabSize": 4
		},
		"[json]": {
			"editor.defaultFormatter": "vscode.json-language-features",
			"editor.tabSize": 2
		},
		"[jsonc]": {
			"editor.defaultFormatter": "vscode.json-language-features",
			"editor.tabSize": 2
		},
		"[markdown]": {
			"editor.wordWrap": "on",
			"editor.defaultFormatter": "vscode.markdown-language-features"
		},
		"[blade]": {
			"editor.defaultFormatter": "shufo.vscode-blade-formatter"
		},
		"php-cs-fixer.onsave": true,
		"php-cs-fixer.formatHtml": true,
		"php-cs-fixer.allowRisky": true,
		"php-cs-fixer.executablePath": "php-cs-fixer",
		"php-cs-fixer.executablePathWindows": "php-cs-fixer.bat",
		"vscode-php-cs-fixer.allowRisky": true,
		"vscode-php-cs-fixer.useCache": true,
		"phpmd.enabled": false,
		"phpmd.validate.rulesets": "cleancode,codesize,controversial,design,naming,unusedcode",
		"phpmd.SuppressWarnings": true,
		"phpmd.verbose": false,
		"intelephense.environment.phpVersion": "8.3.0",
		"intelephense.environment.documentRoot": "laravel/public",
		"intelephense.files.maxSize": 5000000,
		"intelephense.files.exclude": [
			"**/.git/**",
			"**/node_modules/**",
			"**/vendor/**/Tests/**",
			"**/vendor/**/tests/**",
			"**/storage/**",
			"**/bootstrap/cache/**",
			"**/.phpunit.cache/**",
			"**/public/build/**",
			"**/public/hot"
		],
		"intelephense.diagnostics.undefinedTypes": true,
		"intelephense.diagnostics.undefinedFunctions": true,
		"intelephense.diagnostics.undefinedConstants": true,
		"intelephense.diagnostics.undefinedClassConstants": true,
		"intelephense.diagnostics.undefinedMethods": true,
		"intelephense.diagnostics.undefinedProperties": true,
		"intelephense.diagnostics.undefinedVariables": true,
		"git.autofetch": true,
		"git.ignoreLimitWarning": true,
		"git.detectSubmodules": false,
		"git.autoRepositoryDetection": true,
		"git.repositoryScanMaxDepth": 3,
		"search.exclude": {
			"**/node_modules": true,
			"**/vendor": true,
			"**/storage/logs": true,
			"**/storage/framework": true,
			"**/bootstrap/cache": true,
			"**/.phpunit.cache": true,
			"**/public/build": true,
			"**/*.min.js": true,
			"**/*.min.css": true,
			"**/_archive*/**": true
		},
		"files.watcherExclude": {
			"**/.git/objects/**": true,
			"**/.git/subtree-cache/**": true,
			"**/node_modules/**": true,
			"**/vendor/**": true,
			"**/storage/logs/**": true,
			"**/storage/framework/**": true,
			"**/bootstrap/cache/**": true,
			"**/.phpunit.cache/**": true,
			"**/public/build/**": true
		},
		"files.exclude": {
			"**/.git": false,
			"**/.DS_Store": true,
			"**/Thumbs.db": true
		},
		"terminal.integrated.cwd": "${workspaceFolder:laravel}",
		"deepscan.enable": false
	},
	"extensions": {
		"recommendations": [
			"bmewburn.vscode-intelephense-client",
			"junstyle.php-cs-fixer",
			"mehedidracula.php-namespace-resolver",
			"onecentlin.laravel-blade",
			"shufo.vscode-blade-formatter",
			"amiralizadeh9480.laravel-extra-intellisense",
			"editorconfig.editorconfig",
			"bradlc.vscode-tailwindcss",
			"mikestead.dotenv"
		],
		"unwantedRecommendations": [
			"felixfbecker.php-intellisense",
			"ikappas.phpcs"
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": []
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "phpstan: Modules",
				"type": "shell",
				"command": "php -d memory_limit=2048M ./vendor/bin/phpstan analyse Modules",
				"options": {
					"cwd": "${workspaceFolder:laravel}"
				},
				"group": "test",
				"presentation": {
					"reveal": "always",
					"panel": "shared"
				}
			},
			{
				"label": "pest: filter",
				"type": "shell",
				"command": "./vendor/bin/pest --filter=${input:pestFilter}",
				"options": {
					"cwd": "${workspaceFolder:laravel}"
				},
				"group": "test"
			},
			{
				"label": "gitmodules: list paths",
				"type": "shell",
				"command": "bash bashscripts/tools/parse_gitmodules_ini.sh gitmodules.ini",
				"options": {
					"cwd": "${workspaceFolder:base_techplanner}"
				},
				"group": "none"
			}
		]
	},
	"inputs": [
		{
			"id": "pestFilter",
			"type": "promptString",
			"description": "Pest --filter value",
			"default": ""
		}
	]
}
