{
    "autoload": {
        "psr-4": {
            "App\\": "laravel/app/",
            "Database\\Factories\\": "laravel/database/factories/",
            "Database\\Seeders\\": "laravel/database/seeders/",
            "Modules\\": "laravel/Modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
           "Tests\\": "laravel/tests/",
           "Modules\\": "laravel/Modules/"
        }
    },
    "require-dev": {
        "filament/upgrade": "~4.0",
        "phpmd/phpmd": "^2.15"
    }
}
