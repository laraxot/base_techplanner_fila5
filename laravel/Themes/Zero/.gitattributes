# Prototipo .gitattributes per laravel/Modules/* e laravel/Themes/*
# Canon: repository binary attribute policy.
# Sync:  bash bashscripts/templates/sync-gitattributes-modules.sh
#
# I binari restano blob Git normali.

* text=auto
*.css linguist-vendored
*.scss linguist-vendored
*.js linguist-vendored
CHANGELOG.md export-ignore
# Binari come blob Git normali.
# `binary` disattiva diff e normalizzazione di fine riga.
# `!filter` annulla eventuali filtri ereditati dalla configurazione di sistema.
*.png binary !filter
*.jpg binary !filter
*.jpeg binary !filter
*.gif binary !filter
*.webp binary !filter
*.ico binary !filter
*.svg binary !filter
*.mp4 binary !filter
*.psd binary !filter
*.pdf binary !filter
*.zip binary !filter
*.woff binary !filter
*.woff2 binary !filter
*.ttf binary !filter
*.eot binary !filter
*.otf binary !filter
*.phar binary !filter
*.db binary !filter
*.sqlite binary !filter
*.png !text !filter !merge !diff
*.svg !text !filter !merge !diff
*.jpg !text !filter !merge !diff
*.jpeg !text !filter !merge !diff
*.gif !text !filter !merge !diff
*.webp !text !filter !merge !diff
