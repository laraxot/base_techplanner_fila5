# ==============================================
# DEPENDENCIES
# ==============================================
/vendor/
*.phar
node_modules/
package-lock.json

# ==============================================
# ENV & SECRETS
# ==============================================
.env
storage/*.key
Homestead.yaml
Homestead.json
/.vagrant

# ==============================================
# LARAVEL / LUMEN RUNTIME
# ==============================================
bootstrap/compiled.php
app/storage/
public/storage
public/hot
public_html/storage
public_html/hot
build/
cache/
docs/cache/
bin/venv/
venv/

# ==============================================
# CACHES & LOGS
# ==============================================
*.cache
*.log
npm-debug.log
yarn-error.log
.phpunit.result.cache
.php-cs-fixer.cache
.git-rewrite/
*.git-blame-ignore-revs
.git-blame-ignore-revs
*.lock

# ==============================================
# PHPSTAN / DOCS CACHE
# ==============================================
docs/phpstan/

# ==============================================
# BACKUP / MERGE RESIDUE (never commit)
# ==============================================
*.old
*.old1
*.backup
*.backup.*
*.orig
*.rej
*~HEAD
*~BASE
*~LOCAL
*~REMOTE
*~head

# ==============================================
# PROJECT SCRATCH
# ==============================================
lang/lang/
_docs/
agentdb.rvf
tests/AuditCoverage

