{
    "name": "laraxot/module_seo_fila5",
    "description": "Modulo SEO per l'ottimizzazione dei contenuti",
    "homepage": "https://github.com/laraxot/module_seo_fila5",
    "license": "MIT",
    "authors": [
        {
            "name": "marco sottana",
            "email": "marco.sottana@gmail.com",
            "role": "Developer"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Seo\\Providers\\SeoServiceProvider",
                "Modules\\Seo\\Providers\\Filament\\AdminPanelProvider"
            ],
            "aliases": {

            }
        }
    },
    "autoload": {
        "psr-4": {
            "Modules\\Seo\\": "app/",
            "Modules\\Seo\\Database\\Factories\\": "database/factories/",
            "Modules\\Seo\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\Seo\\Tests\\": "tests/"
        }
    },
    "require": {
        "spatie/laravel-sitemap": "^7.0",
        "spatie/laravel-feed": "^4.4"
    },
    "require-dev_comment": {
        "laravel/pint": "^1.13",
        "larastan/larastan": "*",
        "driftingly/rector-laravel": "^0.26.2",
        "symplify/phpstan-rules": "*",
        "rector/rector": "^0.18.12",
        "thecodingmachine/phpstan-safe-rule": "^1.2"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../Xot"
        },
        {
            "type": "path",
            "url": "../Tenant"
        },
        {
            "type": "path",
            "url": "../UI"
        }
    ],
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
