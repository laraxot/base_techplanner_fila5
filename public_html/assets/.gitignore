# public_html/assets/<modulo minuscolo> = ln -s ../../laravel/Modules/<Modulo>/public (php artisan xot:module-link).
# Due righe per nome, come le scrive EnsureGitignoreEntriesAction:
#   <nome>/  cartella vera (copia da vendor:publish, npm run copy, vecchi rilasci): ignorata, mai nel repo;
#   <nome>   il symlink: in questo repo i link esistenti sono comunque tracciati (git add -f), perché un clone
#            funzioni senza comandi; .gitignore non tocca i file già tracciati. Avere già entrambe le righe evita
#            che xot:module-link modifichi questo file sul server (bloccherebbe il git pull del rilascio).
